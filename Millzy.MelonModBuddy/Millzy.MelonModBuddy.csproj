<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <LangVersion>11</LangVersion>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Title>MelonModBuddy</Title>
        <Authors>Millzy</Authors>
        <Copyright>Copyright (c) 2026 Millzy</Copyright>
        <AssemblyVersion>1.0.4</AssemblyVersion>
        <FileVersion>1.0.4</FileVersion>
        <Configurations>Debug;Release</Configurations>
        <Platforms>AnyCPU;Android</Platforms>
        <Description>MSBuild utilities for MelonLoader mod projects.</Description>
        <RepositoryUrl>https://github.com/MillzyDev/Millzy.MelonModBuddy.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageProjectUrl>https://github.com/MillzyDev/Millzy.MelonModBuddy</PackageProjectUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <EnablePackageValidation>true</EnablePackageValidation>
    </PropertyGroup>
    
    <PropertyGroup>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IsRoslynComponent>true</IsRoslynComponent>
        <SupressDependenciesWhenPacking>true</SupressDependenciesWhenPacking>
    </PropertyGroup>
    
    <PropertyGroup>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    
    <ItemGroup>
        <None Include="$(SolutionDir)\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="[4.0.1,)" PrivateAssets="all" />
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="[4.0.1,)" PrivateAssets="all" />
      <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="All" />
    </ItemGroup>
    

    <ItemGroup>
        <None Include="$(OutputPath)\$(AssemblyName).dll" 
              Pack="true"
              PackagePath="analyzers/dotnet/cs" 
              Visible="false" />
        <None Include="Millzy.MelonModBuddy.targets" 
              Pack="true" 
              PackagePath="build;buildTransitive" />
    </ItemGroup>

    <ItemGroup>
      <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
      <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    </ItemGroup>
</Project>
