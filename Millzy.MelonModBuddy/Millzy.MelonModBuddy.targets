<Project>
    <ItemDefinitionGroup>
        <ModDependencies>
            <Visible>false</Visible>
        </ModDependencies>
    </ItemDefinitionGroup>
    
    <ItemGroup>
        <!-- Ensure the required properties are added to the compiler config -->
        <CompilerVisibleProperty Include="ModInfoNamespace" />
        <CompilerVisibleProperty Include="ModInfoClassName" />
        
        <CompilerVisibleProperty Include="ModName" />
        <CompilerVisibleProperty Include="ModId" />
        <CompilerVisibleProperty Include="ModAuthor" />
        <CompilerVisibleProperty Include="ModVersion" />
        
        <!-- MelonLoader properties -->
        <CompilerVisibleProperty Include="ModClassName" />
        <CompilerVisibleProperty Include="ModApplyMelonAttributes" />
        <CompilerVisibleProperty Include="ModUseMelonId" />
        <CompilerVisibleProperty Include="MelonGameDeveloper" />
        <CompilerVisibleProperty Include="MelonGameName" />
    </ItemGroup>
    
    <!-- Utility task to check file bytes -->
    <UsingTask TaskName="CheckForBOM"
               TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll" >
        <ParameterGroup>
            <Filepath ParameterType="System.String" Required="true" />
            <Result ParameterType="System.Boolean" Output="true" />
        </ParameterGroup>
        
        <Task>
            <Using Namespace="System.IO" />
            <Code Type="Fragment" Language="cs">
                <![CDATA[
                    Result = false;
                    
                    if (File.Exists(Filepath)) 
                    {
                        using (FileStream fs = File.OpenRead(Filepath))
                        {
                            byte[] bytes = new byte[4];
                            int read = fs.Read(bytes, 0, 4);
                            
                            // UTF-8 BOM
                            if (read >= 3) 
                            {
                                Result = Result || (bytes[0] == 0xEF && bytes[1] == 0xBB && bytes[2] == 0xBF);
                            }
                            
                            // UTF-16 BOM
                            if (read >= 2)
                            {
                                Result = Result 
                                    || (bytes[0] == 0xFE && bytes[1] == 0xFF)
                                    || (bytes[0] == 0xFF && bytes[1] == 0xFE);
                            }
                            
                            // UTF-32 BOM
                            if (read >= 4)
                            {
                                Result = Result
                                    || (bytes[0] == 0x00 && bytes[1] == 0x00 && bytes[2] == 0xFE && bytes[3] == 0xFF)
                                    || (bytes[0] == 0xFF && bytes[1] == 0xFE && bytes[2] == 0x00 && bytes[3] == 0x00);
                            }
                        }
                    }
                ]]>
            </Code>
        </Task>
    </UsingTask>
    
    <!-- Set default property values -->
    <PropertyGroup>
        <ModVersion Condition="'$(ModVersion)' == ''">0.1.0</ModVersion>
        <ModId Condition="'$(ModAuthor)' == ''">$(ModAuthor).$(ModName)</ModId>
        <ModIcon Condition="'$(ModIcon)' == ''">$(SolutionDir)\icon.png</ModIcon>
        <ModReadme Condition="'$(ModReadme)' == ''">$(SolutionDir)\README.md</ModReadme>
        <ModChangelog Condition="'$(ModChangelog)' == ''">$(SolutionDir)\CHANGELOG.md</ModChangelog>
    </PropertyGroup>
    
    <Target Name="ProjectSetupRecommendations"
            AfterTargets="BeforeBuild" >
        <Warning Text="CopyToModsFolder is enabled but doesn't appear to be defined in a user file. It is recommended you define it in $(MSBuildProjectFullPath).user."
                 Condition="'$(CopyToModsFolder)' == 'true' And !Exists('$(MSBuildProjectFullPath).user')" />
    </Target>
    
    <Target Name="ValidateThunderstorePackage"
            AfterTargets="BeforeBuild" >

        <Error Text="ModName can only contain characters a-z, A-Z, 0-9, and _"
               Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(ModName)', '^[a-zA-Z0-9_]+%24'))" />
        <Error Text="ModName can be no more than 128 characters long." 
               Condition="$(ModName.Length) &gt; 128" />
        
        <Error Text="ModVersion must be formatted as Major.Minor.Patch"
               Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(ModVersion)', '^[0-9]+\.[0-9]+\.[0-9]+%24'))" />
        
        <Error Text="ModDescription can be no more than 250 characters long."
               Condition="$(ModDescription.Length) &gt; 250" />


        <CheckForBOM Filepath="$(ModReadme)">
            <Output TaskParameter="Result" PropertyName="ModReadmeHasBom" />
        </CheckForBOM>
        <CheckForBOM Filepath="$(ModChangelog)">
            <Output TaskParameter="Result" PropertyName="ModChangelogHasBom" />
        </CheckForBOM>
        
        <Error Text="Supplied README file has a BOM (Byte order mark), which is forbidden"
               Condition="$(ModReadmeHasBom)" />
        <Error Text="Supplied CHANGELOG file has a BOM (Byte order mark), which is forbidden"
               Condition="$(ModChangelogHasBom)" />
        
    </Target>
    
    <!-- Copy To Mods Folder Target -->
    <Target Name="CopyToModsFolder"
            AfterTargets="PostBuildEvent"
            Condition="'$(CopyToModsFolder)' == 'true'">
        
        <Error Text="Provided game install ($(GamePath)) location doesn't exist. Make sure GamePath is properly defined."
                 Condition="!Exists('$(GamePath)') or '$(GamePath)' == ''" />

        <PropertyGroup>
            <ModsPath>$(GamePath)\Mods</ModsPath>
        </PropertyGroup>
        
        <Warning Text="Provided game installation doesn't have a mods folder. This could indicate the path is wrong. Will copy to location anyway."
                 Condition="!Exists('$(GamePath)\Mods')" />
        
        <MakeDir Directories="$(ModsPath)"
                 Condition="!Exists('$(ModsPath)')" />
        
        <ItemGroup>
            <ModFiles Include="$(OutputPath)\$(AssemblyName).dll" />
            <ModFiles Include="$(OutputPath)\$(AssemblyName).pdb"
                      Condition="Exists('$(OutputPath)\$(AssemblyName).pdb')" />
            <ModFiles Include="$(OutputPath)\$(AssemblyName).xml"
                      Condition="Exists('$(OutputPath)\$(AssemblyName).xml')" />
        </ItemGroup>

        <Copy SourceFiles="@(ModFiles)"
              DestinationFolder="$(ModsPath)"
              SkipUnchangedFiles="true" />  
    </Target>
    
    <!-- Install on Android/Quest devices -->
    <Target Name="AdbPushToModsFolder"
            AfterTargets="PostBuildEvent"
            Condition="'$(AdbPushToModsFolder)' == 'true'">
        <Error Text="AdbPushToModsFolder is enabled but AndroidGamePackageName is not defined."
               Condition="'$(AndroidGamePackageName)' == ''" />
               
        
        <PropertyGroup>
            <AndroidDestination>/sdcard/MelonLoader/$(AndroidGamePackageName)/Mods</AndroidDestination>
        </PropertyGroup>
        
        <Exec Command="adb push '$(OutputPath)/$(AssemblyName).dll' '$(AndroidDestination)/$(AssemblyName).dll'"
              EchoOff="true" />
        <Exec Command="adb push '$(OutputPath)/$(AssemblyName).pdb' '$(AndroidDestination)/$(AssemblyName).pdb'"
              EchoOff="true"
              Condition="Exists('$(OutputPath)\$(AssemblyName).pdb')"/>
    </Target>
    
    <!-- Thunderstore Package Target -->
    <Target Name="CreateThunderstorePackage" 
            AfterTargets="PostBuildEvent" 
            Condition="'$(ThunderstorePackage)' == 'true'">
        <PropertyGroup>
            <ThunderstorePath>$(OutputPath)\Thunderstore</ThunderstorePath>
            <ThunderstoreModsPath>$(ThunderstorePath)\Mods</ThunderstoreModsPath>
        </PropertyGroup>
        
        <!-- Get list of files to include in the ZIP -->
        <ItemGroup>
            <ThunderstoreFiles Include="$(ModIcon)" />
            <ThunderstoreFiles Include="$(ModReadme)" />
            <ThunderstoreFiles Include="$(ModChangelog)" 
                               Condition="Exists('$(ModChangelog)')" />
            
            <ThunderstoreFilesDestination Include="$(ThunderstorePath)\icon.png" />
            <ThunderstoreFilesDestination Include="$(ThunderstorePath)\README.md" />
            <ThunderstoreFilesDestination Include="$(ThunderstorePath)\CHANGELOG.md"
                                          Condition="Exists('$(ModChangelog)')" />
            
            <ModFiles Include="$(OutputPath)\$(AssemblyName).dll" />
            <ModFiles Include="$(OutputPath)\$(AssemblyName).pdb" 
                      Condition="Exists('$(OutputPath)\$(AssemblyName).pdb')" />
            <ModFiles Include="$(OutputPath)\$(AssemblyName).xml" 
                      Condition="Exists('$(OutputPath)\$(AssemblyName).xml')" />
        </ItemGroup>

        <Message Importance="high" Text="Staging Thunderstore files" /> 
        
        <!-- Copy files to output directory into a folder for Thunderstore items -->
        <MakeDir Directories="$(ThunderstorePath)" />
        <MakeDir Directories="$(ThunderstoreModsPath)" />
        <Copy SourceFiles="@(ThunderstoreFiles)" 
              DestinationFiles="@(ThunderstoreFilesDestination)" />
        <Copy SourceFiles="@(ModFiles)" 
              DestinationFolder="$(ThunderstoreModsPath)" />
        
        <Message Importance="high" Text="Creating manifest.json" />
        
        <!-- Create manifest.json -->
        <PropertyGroup>
            <ManifestJsonContent>
{
    "name": "$(ModName)",
    "description": "$(ModDescription)",
    "version_number": "$(ModVersion)",
    "website_url": "$(ModWebsite)",
    "dependencies": [
        "@(ModDependencies -> '%(Identity)', '",%0A        "')"           
    ]
}
            </ManifestJsonContent>
        </PropertyGroup>
        
        <WriteLinesToFile File="$(ThunderstorePath)\manifest.json"
                          Lines="$(ManifestJsonContent)"
                          Overwrite="true"
                          WriteOnlyWhenDifferent="true" />
        
        <Message Importance="high" Text="Building Thunderstore package" />
        
        <ZipDirectory DestinationFile="$(OutputPath)\$(ModName)-$(ModVersion).zip" 
                      SourceDirectory="$(ThunderstorePath)"
                      Overwrite="true" />
    </Target>
</Project>  